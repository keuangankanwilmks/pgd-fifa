# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Sheets spreadsheet identifier used by the frontend request payload.
# The spreadsheet itself should be restricted and shared only with the service account.
VITE_REKON_SPREADSHEET_ID=1-L6AuP8AupNyutb-9aK4tyFsLT78wY-Y4M8pK_OZC7s

# All Google Sheets read/write/update/delete operations use the Vercel API Route.
VITE_SHEETS_PROXY_URL=/api/sheets-proxy
# Optional. If SHEETS_PROXY_SECRET is set on Vercel, set this to the same value.
# This is only a basic guard because VITE_* values are visible in the browser.
VITE_SHEETS_PROXY_SECRET=

# Vercel/server-only environment variables. Do not prefix secrets with VITE_.
REKON_SPREADSHEET_ID=1-L6AuP8AupNyutb-9aK4tyFsLT78wY-Y4M8pK_OZC7s
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON
# SHEETS_PROXY_SECRET=optional_same_value_as_VITE_SHEETS_PROXY_SECRET

# Firebase Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# Email Blast Hutang Operasional Lain
VITE_EMAIL_BLAST_WEB_APP_URL=https://script.google.com/macros/s/AKfycbzSHuv5sBqWP1fzpctfoZxXcT879DvFyV7Ukj_DJRnsJCIQKM2JGmVg7EHeuU2tjwNa/exec
