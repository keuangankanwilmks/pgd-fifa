# APP_URL: URL tempat aplikasi di-host.
APP_URL="MY_APP_URL"

# Google Sheets via Vercel API Route.
VITE_REKON_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
REKON_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
VITE_SHEETS_PROXY_URL=/api/sheets-proxy

# Google Sheets proxy uses the signed-in user's Firebase ID token.
GOOGLE_DRIVE_APPROVAL_FOLDER_ID=YOUR_SHARED_DRIVE_FOLDER_ID
FIRESTORE_DATABASE_ID=ai-studio-a4f3ceec-4fe2-4bb5-860f-0282bf6bc9ef

# Server-only. Never commit the real service-account JSON or base64 value.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# Firebase frontend configuration.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# Email Blast Hutang Operasional Lain.
VITE_EMAIL_BLAST_WEB_APP_URL=YOUR_APPS_SCRIPT_WEB_APP_URL
