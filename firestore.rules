// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - nik: string (required) - Employee ID
//   - name: string (required) - Full name
//   - role: string (required, admin|user) - Role
//   - status: string (required, active|inactive) - Status
//   - email: string (optional) - User email
//   - uid: string (optional) - Auth UID
//
// Collection: cabang
// Document ID: {cabangId}
// Fields:
//   - nama: string (required) - Branch name
//
// Collection: plafon
// Document ID: {plafonId}
// Fields:
//   - namaCabang: string (required) - Branch name
//   - nominal: number (required) - Plafond amount
//
// Collection: norek_mapping
// Document ID: {mappingId}
// Fields:
//   - keterangan: string (required) - Keyword
//   - namaCabang: string (required) - Branch name
//
// Collection: supporting_apps
// Document ID: {appId}
// Fields:
//   - label: string (required) - Display name
//   - url: string (required, format: uri) - App URL
//
// Collection: gl_bank
// Document ID: {bankId}
// Fields:
//   - bank: string (required) - Bank name/code
//   - noRekening: string (optional) - Bank account number
//   - nomorGL: string (required) - GL number
//   - pic: string (required) - Person in charge
//
// Collection: mata_anggaran
// Document ID: {mappingId}
// Fields:
//   - mataAnggaran: string (required)
//   - kodeActivity: string (required)
//
// Collection: penandatangan
// Document ID: input_dropping
// Fields:
//   - disetujuiOleh: string
//   - diperiksaOleh: string
//   - dibuatOleh: string
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActiveUser() {
      return isAuthenticated() &&
             exists(userPath()) &&
             get(userPath()).data.status == 'active';
    }

    function isAdmin() {
      return isActiveUser() &&
             (
               request.auth.token.email == 'keuangan.kanwilmks@gmail.com' ||
               get(userPath()).data.role == 'admin'
             );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidRoleId(roleId) {
      return roleId.matches('^[a-z0-9-_]+$');
    }

    function isValidDatabaseAction(value) {
      return value is map &&
             value.keys().hasOnly(['edit', 'delete']) &&
             (!('edit' in value) || value.edit is bool) &&
             (!('delete' in value) || value.delete is bool);
    }

    function isValidDatabasePermissions(value) {
      return value is map &&
             value.keys().hasOnly([
               'data-moker',
               'data-rekon',
               'saldo-harian',
               'hutang-operasional',
               'anggaran'
             ]) &&
             (!('data-moker' in value) || isValidDatabaseAction(value['data-moker'])) &&
             (!('data-rekon' in value) || isValidDatabaseAction(value['data-rekon'])) &&
             (!('saldo-harian' in value) || isValidDatabaseAction(value['saldo-harian'])) &&
             (!('hutang-operasional' in value) || isValidDatabaseAction(value['hutang-operasional'])) &&
             (!('anggaran' in value) || isValidDatabaseAction(value['anggaran']));
    }

    function isValidRoleAccess(data) {
      return data.keys().hasOnly(['label', 'menuIds', 'databasePermissions', 'createdAt', 'updatedAt']) &&
             data.label is string && data.label.size() > 0 &&
             data.menuIds is list && data.menuIds.size() <= 100 &&
             (!('databasePermissions' in data) || isValidDatabasePermissions(data.databasePermissions));
    }

    function isValidPlafon(data) {
      return data.keys().hasOnly(['namaCabang', 'nominal']) &&
             data.namaCabang is string && data.namaCabang.size() > 0 &&
             data.nominal is number && data.nominal >= 0;
    }

    function isValidAppSetting(data) {
      return data.keys().hasOnly(['html', 'text', 'configs', 'updatedAt']) &&
             (!('html' in data) || data.html is string) &&
             (!('text' in data) || data.text is string) &&
             (!('configs' in data) || data.configs is map) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    match /_connection_test_/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /cabang/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /plafon/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin() && isValidPlafon(request.resource.data);
    }

    match /norek_mapping/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /supporting_apps/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /gl_bank/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /mata_anggaran/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /penandatangan/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /role_access/{roleId} {
      allow read: if isAdmin() ||
                  (isActiveUser() && get(userPath()).data.role == roleId);
      allow create, update: if isAdmin() &&
                            isValidRoleId(roleId) &&
                            isValidRoleAccess(request.resource.data);
      allow delete: if isAdmin() &&
                    roleId != 'admin' &&
                    roleId != 'user' &&
                    roleId != 'guest';
    }

    match /app_settings/{settingId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() && isValidAppSetting(request.resource.data);
      allow delete: if isAdmin();
    }

    match /allocation_approval_batches/{batchId} {
      // Metadata hanya diakses melalui API FIFA yang memverifikasi ID token.
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isActiveUser() && isOwner(resource.data.userId);
      allow create: if isActiveUser() && isOwner(request.resource.data.userId);
    }

    match /users/{userId} {
      allow read: if isActiveUser() && (isOwner(userId) || isAdmin());
      // Create/update/delete user dilakukan oleh API backend Firebase Admin SDK.
      allow create, update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
